<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@color/bg_card" android:padding="20dp">
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center">
        <NumberPicker android:id="@+id/npYear" android:layout_width="0dp" android:layout_weight="1" android:layout_height="150dp"/>
        <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:text="年" android:gravity="center"
            android:textColor="@color/text_primary" android:textSize="16sp"/>
        <NumberPicker android:id="@+id/npMonth" android:layout_width="0dp" android:layout_weight="1" android:layout_height="150dp"/>
        <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:text="月" android:gravity="center"
            android:textColor="@color/text_primary" android:textSize="16sp"/>
    </LinearLayout>
    <Button android:id="@+id/btnOk" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="16dp" android:text="跳转" android:textSize="16sp"
        android:textColor="#FFFFFF" android:background="@drawable/cell_today_selected"/>
</LinearLayout>
