<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_dark">
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="56dp"
        android:background="@color/theme_green" android:gravity="center">
        <TextView android:id="@+id/tvDate" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="日期" android:textSize="18sp" android:textColor="#FFFFFF" android:gravity="center"/>
    </LinearLayout>
    <EditText android:id="@+id/etNote" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_margin="16dp" android:gravity="top" android:padding="14dp" android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:background="@color/bg_card"/>
    <Button android:id="@+id/btnSave" android:layout_width="220dp" android:layout_height="48dp"
        android:layout_gravity="center_horizontal" android:layout_marginBottom="24dp"
        android:text="保存" android:textSize="16sp" android:textColor="#FFFFFF"
        android:background="@drawable/cell_today_selected"/>
</LinearLayout>
